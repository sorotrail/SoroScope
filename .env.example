# Which backend SoroScope reads events from.
#   rpc        standalone: poll Stellar RPC and store events in Postgres
#   sorotrail  upstream:   read from a SoroTrail indexer's HTTP API
SOURCE_MODE=rpc

# --- Standalone mode (SOURCE_MODE=rpc) ---------------------------------------
# Stellar RPC endpoint. Point this at a provider URL for mainnet.
RPC_URL=https://soroban-testnet.stellar.org
# Postgres connection string. Required in standalone mode.
DATABASE_URL=postgres://soroscope:soroscope@localhost:5432/soroscope?sslmode=disable
# How long to sleep between polls once caught up to the chain tip.
POLL_INTERVAL=5s
# Comma-separated contract IDs to watch. Empty ingests every contract event.
WATCHED_CONTRACTS=
# Force a cold start from a specific ledger. Leave unset to reach back
# RETENTION_LEDGERS from the current tip.
# START_LEDGER=
# Cold-start reach-back in ledgers (~24h at 5s per ledger).
RETENTION_LEDGERS=17280

# --- Upstream mode (SOURCE_MODE=sorotrail) -----------------------------------
# Base URL of a SoroTrail indexer. Required in upstream mode.
# SOROTRAIL_URL=http://localhost:8080

# --- Shared -------------------------------------------------------------------
HTTP_ADDR=:8080
LOG_LEVEL=info
